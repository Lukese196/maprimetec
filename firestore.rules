rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if user is authenticated (admin)
    function isAdmin() {
      return request.auth != null;
    }

    match /clients/{phone} {
      // Admins can read and write all client data
      allow read, write: if isAdmin();
      // Public can create clients if they don't exist (when submitting a new OS from the site)
      allow create: if !isAdmin() && request.resource.data.keys().hasAll(['name', 'phone', 'createdAt']);
    }

    match /os_list/{osId} {
      // Admins can read, create, and update
      allow read, create, update: if isAdmin();
      
      // Admins shouldn't be able to easily delete, but they can update status to Cancelled.
      allow delete: if false;

      // Public can only create a new OS from the site
      allow create: if !isAdmin() && 
                    request.resource.data.keys().hasAll(['protocol', 'client', 'phone', 'device', 'problem', 'status']) &&
                    request.resource.data.status == 'Aberto';
                    
      // Permissive read for now so tracking works via query. Ideally we'd structure the DB differently.
      allow read: if true; 
    }
  }
}
